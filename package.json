{
  "name": "static-portfolio",
  "version": "1.5.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "prettier": "prettier --write \"src/**/*.{ts,tsx,js,json,graphql,css,html}\"",
    "cleanup": "npm run prettier && npm run lint:fix"
  },
  "dependencies": {
