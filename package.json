{
  "name": "static-portfolio",
  "version": "1.5.2",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && rm -rf out/notes",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "prettier": "prettier --write \"src/**/*.{ts,tsx,json,css}\"",
    "cleanup": "npm run prettier && npm run lint:fix"
  },
  "dependencies": {
    "marked": "^18.1.3",
    "next": "^16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^25",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "unrs-resolver@1.11.1": true
  }
}
